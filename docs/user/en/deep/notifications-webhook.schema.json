        "more": {
          "default": 0,
          "title": "More",
          "type": "integer"
        },
        "others": {
          "default": 0,
          "title": "Others",
          "type": "integer"
        },
        "private": {
          "default": 0,
          "title": "Private",
          "type": "integer"
        },
        "scope": {
          "description": "quiet_hours or pause.",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "count"
      ],
      "title": "DigestData",
      "type": "object"
