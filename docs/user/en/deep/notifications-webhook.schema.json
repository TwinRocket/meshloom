          "title": "Count",
          "type": "integer"
        },
        "dms": {
          "default": 0,
          "title": "Dms",
          "type": "integer"
        },
        "items": {
          "description": "Named conversations: [name, count], top three.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Items",
          "type": "array"
