    "DigestData": {
      "additionalProperties": false,
      "description": "What quiet hours or a pause held, counted (no text).",
      "properties": {
        "contacts": {
          "default": 0,
          "title": "Contacts",
          "type": "integer"
        },
        "conversations": {
          "default": 0,
