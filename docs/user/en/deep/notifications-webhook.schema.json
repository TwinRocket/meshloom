          "title": "Event Id",
          "type": "string"
        },
        "instance": {
          "$ref": "#/$defs/Instance"
        },
        "occurred_at": {
          "description": "Epoch seconds.",
          "title": "Occurred At",
          "type": "integer"
        },
        "rendered": {
          "$ref": "#/$defs/RenderedText"
        },
        "urgent": {
          "default": false,
          "title": "Urgent",
          "type": "boolean"
        },
        "version": {
          "const": 2,
          "default": 2,
          "title": "Version",
          "type": "integer"
        }
