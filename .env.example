MESHLOOM_HTTP_PORT=8123
MESHLOOM_DATA_PATH=/opt/docker/meshloom/data

MESHCORE_DATABASE_PATH=data/meshcore.db
# Set to true to lock every extension (plugin).
MESHCORE_DISABLE_PLUGINS=false
# The Web Push contact (VAPID subject) is set in Settings → Notifications, not here.
# Meshloom Community is joined from Settings > Meshloom Community (opt-in). No variable sets it.
