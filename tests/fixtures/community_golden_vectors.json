        "packet_hash": "19D68FE91E75C7DE",
        "note": "FLOOD (route 1), payload_type 4 (ADVERT), no path"
      },
      {
        "id": "transport_flood",
        "raw_hex": "100102030400CAFE",
        "packet_hash": "4776D59C7360344B",
        "note": "TRANSPORT_FLOOD (route 0): 4 transport-code bytes skipped"
      },
