name: meshloom
arch: __NFPM_ARCH__
platform: linux
version: __NFPM_VERSION__
release: "1"
section: net
priority: optional
maintainer: "Pascal M <macri.pascal@gmail.com>"
description: Web interface for MeshCore mesh radio networks
vendor: Meshloom
homepage: https://github.com/TwinRocket/meshloom
license: MIT
contents:
  - src: __STAGING__/opt/meshloom
    dst: /opt/meshloom
  # Recovery command (app/cli.py), next to the interpreter it needs.
  - src: __PKGDIR__/meshloom-admin
    dst: /opt/meshloom/.venv/bin/meshloom-admin
    file_info:
      mode: 0755
  - src: /opt/meshloom/.venv/bin/meshloom-admin
    dst: /usr/bin/meshloom-admin
    type: symlink
  - src: __PKGDIR__/meshloom.service
    dst: /usr/lib/systemd/system/meshloom.service
    file_info:
      mode: 0644
  - src: __PKGDIR__/apply-update
    dst: /usr/lib/meshloom/apply-update
    file_info:
      mode: 0755
  # Kiosk launcher at the path images flashed before 5.0.0 already use; the
  # image owns the autostart entry (pkg/rpi/meshloom-kiosk.desktop).
  - src: __RPIDIR__/meshloom-kiosk
    dst: /usr/lib/meshloom/meshloom-kiosk
    file_info:
      mode: 0755
  - src: __PKGDIR__/meshloom-update.service
    dst: /usr/lib/systemd/system/meshloom-update.service
    file_info:
      mode: 0644
  - src: __PKGDIR__/meshloom-update.path
    dst: /usr/lib/systemd/system/meshloom-update.path
    file_info:
      mode: 0644
  - src: __PKGDIR__/meshloom-update.polkit
    dst: /usr/share/polkit-1/rules.d/60-meshloom-update.rules
    file_info:
      mode: 0644
  # ASCII-armored release key for dnf/rpm (gpgkey=). The binary keyring for
  # apt signed-by= and gpgv is __KEYRING__ below.
  - src: __KEYRING_ASC__
    dst: /usr/share/keyrings/meshloom-archive-keyring.asc
    file_info:
      mode: 0644
  - src: __PKGDIR__/meshloom.pref
    dst: /etc/apt/preferences.d/meshloom.pref
    type: config
    packager: deb
    file_info:
      mode: 0644
  - src: __PKGDIR__/meshloom.env
    dst: /etc/meshloom/meshloom.env
    type: config|noreplace
    file_info:
      mode: 0640
  # fail2ban filter and jail (MSHL-423): config files kept on upgrade, jail
  # shipped disabled (docs/user/en/deep/fail2ban.md). fail2ban is only suggested.
  - src: __PKGDIR__/fail2ban/meshloom-filter.conf
    dst: /etc/fail2ban/filter.d/meshloom.conf
    type: config|noreplace
    file_info:
      mode: 0644
  - src: __PKGDIR__/fail2ban/meshloom-jail.conf
    dst: /etc/fail2ban/jail.d/meshloom.conf
    type: config|noreplace
    file_info:
      mode: 0644
  - src: __PKGDIR__/meshloom.sysusers
    dst: /usr/lib/sysusers.d/meshloom.conf
    file_info:
      mode: 0644
  - src: __PKGDIR__/meshloom.tmpfiles
    dst: /usr/lib/tmpfiles.d/meshloom.conf
    file_info:
      mode: 0644
  # Trust anchor for the signed apt/dnf repository (pkg/keys/README.md).
  - src: __KEYRING__
    dst: /usr/share/keyrings/meshloom-archive-keyring.gpg
    file_info:
      mode: 0644
scripts:
  postinstall: __PKGDIR__/postinstall.sh
  preremove: __PKGDIR__/preremove.sh
  postremove: __PKGDIR__/postremove.sh
# SIGN-BEGIN (lines between the markers are dropped for unsigned local builds;
# release builds require the key, see build_nfpm_packages.sh)
deb:
  signature:
    key_file: __SIGN_KEY_FILE__
    type: origin
# SIGN-END
overrides:
  # bubblewrap isolates the plugin children (app/plugins/isolation/bwrap.py).
  # Recommended, not required: without it plugins run "hooks only", logged and
  # shown in /api/health.
  deb:
    depends:
      - libc6
    recommends:
      - bubblewrap
    suggests:
      - fail2ban
  rpm:
    depends:
      - glibc
    recommends:
      - bubblewrap
    suggests:
      - fail2ban
rpm:
  scripts:
    posttrans: __PKGDIR__/posttrans.sh
  # SIGN-BEGIN
  signature:
    key_file: __SIGN_KEY_FILE__
  # SIGN-END
