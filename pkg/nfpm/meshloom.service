[Unit]
Description=Meshloom
Documentation=https://github.com/TwinRocket/meshloom
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=meshloom
Group=meshloom
WorkingDirectory=/opt/meshloom
EnvironmentFile=/etc/meshloom/meshloom.env
ExecStart=/opt/meshloom/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --no-proxy-headers
Restart=on-failure
RestartSec=5s

StateDirectory=meshloom

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# The kiosk device token directory exists on kiosk hosts only ("-": optional).
ReadWritePaths=/opt/meshloom /var/lib/meshloom -/var/lib/meshloom-kiosk
SupplementaryGroups=dialout
# Caps every task of the unit (server threads, plugin children and their
# helpers): a plugin that escapes its own limits cannot fork-bomb the host.
TasksMax=512

[Install]
WantedBy=multi-user.target
