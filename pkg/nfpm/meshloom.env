# Meshloom configuration
# https://github.com/TwinRocket/meshloom
#
# Radio transport (serial / TCP / BLE) is configured in the web UI
# and stored in app_settings. Do not set MESHCORE_SERIAL_PORT,
# MESHCORE_TCP_HOST, or MESHCORE_BLE_ADDRESS here.

MESHCORE_DATABASE_PATH=/var/lib/meshloom/meshcore.db

# Bots execute arbitrary Python on the server.
MESHCORE_DISABLE_BOTS=true

#MESHCORE_BASIC_AUTH_USERNAME=
#MESHCORE_BASIC_AUTH_PASSWORD=
#MESHCORE_ENABLE_LOCAL_PRIVATE_KEY_EXPORT=false

# New empty databases join Meshloom Community. Set 0 to seed opted out.
#MESHLOOM_COMMUNITY=0
#MESHLOOM_COMMUNITY_IATA=
#MESHLOOM_COMMUNITY_LOCKED=false
