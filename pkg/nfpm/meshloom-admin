#!/bin/sh
# meshloom-admin: recover access to a Meshloom instance from the host
# (app/cli.py; docs/user/en/deep/access.md).
#
# One wrapper for every install kind that ships a Python tree:
#   - deb/rpm and the RPi image: /opt/meshloom/.venv/bin/meshloom-admin, also
#     linked as /usr/bin/meshloom-admin. Run it with sudo: it reads
#     /etc/meshloom/meshloom.env (root:root 0640 in root:meshloom 0750, refused unless owned by root
#     and not group- or world-writable, nor a link), then drops to the `meshloom`
#     user, which owns the database, so SQLite never leaves root-owned -wal files.
#     The child runs in a session of its own (runuser -c), so it never has
#     root's controlling terminal and cannot push input into it (TIOCSTI);
#     with a terminal on stdin, stdout and stderr it also gets its own pty
#     (runuser --pty).
#   - Docker image and Home Assistant add-on: /usr/local/bin/meshloom-admin, run with
#     `docker compose exec` / `docker exec` (the container user is already right).
# The project is not pip-installed in the venv (no build backend), so a console
# script entry point cannot exist; this wrapper is the command.
#
# The database path is MESHCORE_DATABASE_PATH when set. Otherwise it is found the
# way the service finds it, because an interactive shell or `docker exec` does not
# see the unit's EnvironmentFile or the add-on launcher's environment. With --db,
# the environment file is not read at all (the CLI uses the given path).
#
# Test hooks (not documented for users): MESHLOOM_APP_DIR, MESHLOOM_PACKAGE_ROOT,
# MESHLOOM_ENV_FILE, MESHLOOM_EUID, MESHLOOM_RUNUSER, MESHLOOM_ROOT_UID.
set -eu
# Every tool (id, sed, find, runuser, env) comes from the system directories,
# whatever PATH the caller has (plain `su` keeps the user's).
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

PKG_ROOT="${MESHLOOM_PACKAGE_ROOT:-/opt/meshloom}"
SERVICE_USER=meshloom

if [ -n "${MESHLOOM_APP_DIR:-}" ]; then
    APP="$MESHLOOM_APP_DIR"
elif [ -x "$PKG_ROOT/.venv/bin/python" ]; then
    APP="$PKG_ROOT"
elif [ -x /app/.venv/bin/python ]; then
    APP=/app
else
    echo "meshloom-admin: no Meshloom installation found (looked in $PKG_ROOT and /app)" >&2
    exit 1
fi

PYTHON="$APP/.venv/bin/python"
# -P: the current directory never goes on sys.path, so an app/ folder next to
# the operator cannot shadow the installed code.
set -- -P -m app.cli "$@"

if [ "$APP" = "$PKG_ROOT" ]; then
    if [ "${MESHLOOM_EUID:-$(id -u)}" != 0 ]; then
        echo "meshloom-admin: run it as root: sudo meshloom-admin ..." >&2
        exit 1
    fi
    given_db=
    for arg in "$@"; do
        case "$arg" in
            --db | --db=*) given_db=1 ;;
        esac
    done
    if [ -z "${MESHCORE_DATABASE_PATH:-}" ] && [ -z "$given_db" ]; then
        # Read the unit's environment file as data, never `source` it, and only
        # when root owns it and its directory and nobody else can write them.
        env_file="${MESHLOOM_ENV_FILE:-/etc/meshloom/meshloom.env}"
        root_uid="${MESHLOOM_ROOT_UID:-0}"
        value=
        if [ -e "$env_file" ] || [ -L "$env_file" ]; then
            env_dir=$(dirname "$env_file")
            if [ -L "$env_file" ] || [ ! -f "$env_file" ] \
                || [ -z "$(find "$env_file" -prune -user "$root_uid" ! -perm -020 ! -perm -002)" ] \
                || [ -z "$(find "$env_dir" -prune -user "$root_uid" ! -perm -020 ! -perm -002)" ]; then
                echo "meshloom-admin: refusing $env_file: it must be a regular file owned by root" \
                    "in a root-owned directory, neither group- nor world-writable" \
                    "(chown root:root; chmod 0640); or pass --db" >&2
                exit 1
            fi
            if [ ! -r "$env_file" ]; then
                echo "meshloom-admin: cannot read $env_file; pass --db" >&2
                exit 1
            fi
            value=$(sed -n 's/^MESHCORE_DATABASE_PATH=//p' "$env_file" | tail -n 1 | tr -d '"'"'")
        fi
        MESHCORE_DATABASE_PATH="$value"
    fi
    MESHCORE_DATABASE_PATH="${MESHCORE_DATABASE_PATH:-/var/lib/meshloom/meshcore.db}"
    cd /
    # The meshloom child must never share root's terminal: with root's
    # controlling terminal it could push input into it (TIOCSTI) through any
    # inherited tty fd or by opening /dev/tty, even with every fd piped.
    # `runuser -c` (unlike `runuser -u`) starts the child in a new session, so
    # it has no controlling terminal, and runuser kills it on Ctrl-C. The
    # command reaches `sh -c 'exec "$0" "$@"'` as arguments, never as a string.
    pty=
    if [ -t 0 ] && [ -t 1 ] && [ -t 2 ]; then
        # Fully interactive (password prompts): the child also gets a pty of
        # its own as its controlling terminal. When any fd is redirected, no
        # pty: it would merge stderr into stdout, add CRs and echo piped input,
        # and the tty fds left are not the child's controlling terminal.
        pty=--pty
    fi
    # shellcheck disable=SC2016 # the inner sh expands "$0" "$@", not this one
    exec "${MESHLOOM_RUNUSER:-runuser}" ${pty:+"$pty"} -s /bin/sh -c 'exec "$0" "$@"' \
        -- "$SERVICE_USER" \
        env "MESHCORE_DATABASE_PATH=$MESHCORE_DATABASE_PATH" "PYTHONPATH=$APP" \
        "$PYTHON" "$@"
fi

if [ -z "${MESHCORE_DATABASE_PATH:-}" ]; then
    if [ -f /data/options.json ]; then
        # Home Assistant add-on: meshloom/run.py points the server at /config.
        MESHCORE_DATABASE_PATH=/config/meshcore.db
    else
        MESHCORE_DATABASE_PATH="$APP/data/meshcore.db"
    fi
    export MESHCORE_DATABASE_PATH
fi
PYTHONPATH="$APP${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "$PYTHON" "$@"
