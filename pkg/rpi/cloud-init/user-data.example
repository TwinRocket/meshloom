#cloud-config
# Example only. Imager 2.x generates this on the boot partition.
# The #cloud-config header is required.

hostname: meshloom
enable_ssh: true
ssh_pwauth: false
users:
  - name: admin
    groups: users,adm,dialout,sudo,netdev
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAA... you@machine
    sudo: ALL=(ALL) NOPASSWD:ALL
