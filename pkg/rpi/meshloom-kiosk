#!/bin/sh
# Fullscreen Chromium on the local Meshloom UI.
# XDG / labwc autostart — the flash-time user is unknown at bake.

set -eu

URL="${MESHLOOM_KIOSK_URL:-http://127.0.0.1:8000}"
CHROMIUM="${MESHLOOM_KIOSK_BROWSER:-}"

if [ -z "$CHROMIUM" ]; then
    for candidate in /usr/bin/chromium /usr/bin/chromium-browser; do
        if [ -x "$candidate" ]; then
            CHROMIUM="$candidate"
            break
        fi
    done
fi

if [ -z "${CHROMIUM:-}" ]; then
    echo "meshloom-kiosk: chromium not found" >&2
    exit 1
fi

if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
    echo "meshloom-kiosk: no graphical session" >&2
    exit 1
fi

# labwc autostart and XDG autostart may both fire; keep one Chromium.
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp}"
mkdir -p "$LOCK_DIR"
if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK_DIR/meshloom-kiosk.lock"
    flock -n 9 || exit 0
fi

# GET /api/auth/session is public on 5.x and answers 200 whether or not an
# account exists; /api/health is only {"ok": true} there. The fallback keeps a
# 4.x server (no /api/auth) working.
probe() {
    if command -v curl >/dev/null 2>&1; then
        curl -sf -o /dev/null "$URL$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q -O /dev/null "$URL$1"
    else
        return 1
    fi
}

wait_ready() {
    i=0
    while [ "$i" -lt 180 ]; do
        probe /api/auth/session && return 0
        probe /api/health && return 0
        i=$((i + 1))
        sleep 1
    done
    return 0
}

wait_ready

# TODO(T60): device-token bootstrap. The `kiosk` account has no
# password and no trusted-network rule, so until T60 lands the screen shows the
# setup page (with the installation code) and then the login page. T60 reads
# /var/lib/meshloom/kiosk.token here and passes a one-time bootstrap URL as "$URL".

# Official Pi kiosk flags, plus --password-store=basic so the keyring
# dialog does not block the first launch.
while true; do
    "$CHROMIUM" \
        --kiosk \
        --noerrdialogs \
        --disable-infobars \
        --no-first-run \
        --password-store=basic \
        --enable-features=OverlayScrollbar \
        --start-maximized \
        "$URL" || true
    sleep 2
done
