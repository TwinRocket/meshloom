# Python-generated files
__pycache__/
*.py[oc]
build/
# The two lines below exist so `build/` above does not swallow the release
# scripts; they re-include everything under that directory, bytecode included.
!scripts/build/
!scripts/build/**
scripts/build/**/__pycache__/
wheels/
*.egg-info

# Virtual environments
.venv
frontend/node_modules/
frontend/test-results/

# Frontend build output (built from source by end users)
frontend/dist/
frontend/prebuilt/
frontend/.eslintcache

# Release artifacts
meshloom-prebuilt-frontend-v*.zip
*.img.xz
*.deb

# reference libraries
references/

# ancillary LLM files
.claude/
.codex

# local Docker compose files
docker-compose.yml
docker-compose.yaml
.docker-certs/
.env

# HA test environment (created by scripts/setup/start_ha_test_env.sh)
ha_test_config/
.DS_Store
*.tsbuildinfo
