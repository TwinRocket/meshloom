#!/bin/sh
# Host-side helper for installer-managed Docker Compose (meshloom-compose-update).
#
# Security model (see app/AGENTS.md, "Updates"):
#   - The container only *triggers* this unit (PathChanged= on
#     <dir>/data/request-update). Nothing under data/ is ever read here.
#   - The target is the latest GitHub release, resolved from the
#     releases/latest redirect. Its image digest comes from OCI-DIGESTS, signed
#     with the Meshloom release key (gpgv). Downgrades are refused.
#   - The channel comes from /etc/meshloom/compose-update.env (root-owned, written by
#     the installer), never from the app. On `testing` the target is the newer of that
#     release and what the signed channel file names; a copy of the file older than
#     the last one seen is refused.
#   - The image is pinned by digest in <dir>/.env (MESHLOOM_IMAGE), rewritten
#     with mktemp + mv. docker-compose.yml is never edited.
#   - Progress goes to <dir>/update-status/status.json (root 0755 directory,
#     mounted read-only in the container). On `testing` it also names the channel.
#
# Usage: compose-update             apply the latest release (systemd unit)
#        compose-update --bootstrap  write .env for a fresh install, no pull/up
set -eu

R=
if [ "${MESHLOOM_HELPER_TESTING:-}" = 1 ]; then
    R="${MESHLOOM_HELPER_ROOT:?MESHLOOM_HELPER_ROOT is required in testing mode}"
fi

REPO_URL="https://github.com/TwinRocket/meshloom"
IMAGE_REPO="ghcr.io/twinrocket/meshloom"
CHANNEL_FILE_URL="https://twinrocket.github.io/meshloom/channels/testing.txt"
KEYRING="$R/usr/share/keyrings/meshloom-archive-keyring.gpg"
STATE_DIR="$R/var/lib/meshloom-compose-update"
STAMP_PATH="$STATE_DIR/last-start"
ISSUED_PATH="$STATE_DIR/channel-issued-at"
RUN_DIR="${RUNTIME_DIRECTORY:-$R/run/meshloom-compose-update}"
COOLDOWN_SECONDS=120
VERSION_RE='^[0-9]{1,6}\.[0-9]{1,6}\.[0-9]{1,6}$'
RC_VERSION_RE='^[0-9]{1,6}\.[0-9]{1,6}\.[0-9]{1,6}-rc\.[1-9][0-9]{0,5}$'
DIGEST_RE='^sha256:[0-9a-f]{64}$'
DIR_RE='^/[A-Za-z0-9._/-]+$'

MODE=apply
if [ "${1:-}" = "--bootstrap" ]; then
    MODE=bootstrap
fi

STATE=applying
PHASE=preparing
PERCENT=
ERROR=
STARTED_AT=$(date +%s)
VERSION=
FINISHED=0
STATUS_READY=0
WORK=

log() {
    echo "meshloom compose-update: $*" >&2
}

json_escape() {
    printf '%s' "$1" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

is_root_owned_dir() {
    [ -d "$1" ] && [ ! -L "$1" ] || return 1
    [ -n "$R" ] || [ "$(stat -c %u "$1")" = 0 ]
}

write_status() {
    [ "$STATUS_READY" -eq 1 ] || return 0
    if [ -n "$PERCENT" ]; then percent_json=$PERCENT; else percent_json=null; fi
    if [ -n "$ERROR" ]; then error_json="\"$(json_escape "$ERROR")\""; else error_json=null; fi
    if [ -n "$VERSION" ]; then version_json="\"$VERSION\""; else version_json=null; fi
    now=$(date +%s)
    tmp=$(mktemp "$STATUS_DIR/.status.XXXXXX")
    channel_json=
    if [ "$CHANNEL" = testing ]; then channel_json=',"channel":"testing"'; fi
    printf '{"schema":1,"state":"%s","phase":"%s","percent":%s,"error":%s,"started_at":%s,"updated_at":%s,"version":%s%s}\n' \
        "$STATE" "$PHASE" "$percent_json" "$error_json" "$STARTED_AT" "$now" "$version_json" "$channel_json" >"$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$STATUS_DIR/status.json"
}

fail() {
    FINISHED=1
    STATE=failed
    ERROR=$1
    write_status
    log "failed: $ERROR"
    exit 1
}

on_exit() {
    rc=$?
    if [ -n "$WORK" ]; then rm -rf "$WORK"; fi
    if [ "$FINISHED" -eq 0 ]; then
        FINISHED=1
        STATE=failed
        [ -n "$ERROR" ] || ERROR="update failed (exit $rc)"
        write_status || true
    fi
}

# version_gt A B: true when A > B (X.Y.Z or X.Y.Z-rc.N, already validated). An rc
# sorts before its final release, and rc.10 after rc.9.
version_gt() {
    a=${1%%-rc.*}; b=${2%%-rc.*}
    a1=${a%%.*}; rest=${a#*.}; a2=${rest%%.*}; a3=${rest#*.}
    b1=${b%%.*}; rest=${b#*.}; b2=${rest%%.*}; b3=${rest#*.}
    [ "$a1" -ne "$b1" ] && { [ "$a1" -gt "$b1" ]; return; }
    [ "$a2" -ne "$b2" ] && { [ "$a2" -gt "$b2" ]; return; }
    [ "$a3" -ne "$b3" ] && { [ "$a3" -gt "$b3" ]; return; }
    case "$1" in *-rc.*) ar=${1##*-rc.} ;; *) ar=9999999 ;; esac
    case "$2" in *-rc.*) br=${2##*-rc.} ;; *) br=9999999 ;; esac
    [ "$ar" -gt "$br" ]
}

# Latest release tag from the releases/latest redirect. The Location header
# must be exactly <repo>/releases/tag/X.Y.Z; anything else is refused.
resolve_latest() {
    location=$(curl -fsS --proto '=https' --max-time 20 -o /dev/null -w '%{redirect_url}' \
        "${REPO_URL}/releases/latest") || return 1
    tag=${location#"${REPO_URL}/releases/tag/"}
    [ "$tag" != "$location" ] || return 1
    case "$tag" in
        '' | *[!0-9.]*) return 1 ;;
    esac
    printf '%s\n' "$tag" | grep -Eq "$VERSION_RE" || return 1
    printf '%s' "$tag"
}

# What the testing channel serves, from the file signed with the Meshloom release key:
#   schema=1 / channel=testing / version=<X.Y.Z or X.Y.Z-rc.N> / stable=X.Y.Z / issued_at=<unix>
# Returns 2 when it cannot be downloaded, 3 on a bad signature, 4 on anything else wrong
# with it, 5 when it is older than the copy already accepted.
signed_channel_version() {
    curl -fsSL --proto '=https' --max-time 20 -o "$WORK/testing.txt" "$CHANNEL_FILE_URL" || return 2
    curl -fsSL --proto '=https' --max-time 20 -o "$WORK/testing.txt.asc" "${CHANNEL_FILE_URL}.asc" || return 2
    gpgv --keyring "$KEYRING" "$WORK/testing.txt.asc" "$WORK/testing.txt" >/dev/null 2>&1 || return 3
    [ "$(wc -l <"$WORK/testing.txt" | tr -d ' ')" = 5 ] || return 4
    [ "$(sed -n 1p "$WORK/testing.txt")" = schema=1 ] || return 4
    [ "$(sed -n 2p "$WORK/testing.txt")" = channel=testing ] || return 4
    channel_version=$(sed -n 's/^version=//p' "$WORK/testing.txt")
    printf '%s\n' "$channel_version" | grep -Eq "$VERSION_RE|$RC_VERSION_RE" || return 4
    issued=$(sed -n 's/^issued_at=//p' "$WORK/testing.txt")
    printf '%s\n' "$issued" | grep -Eq '^[0-9]{1,12}$' || return 4
    seen=$(sed -n '1{/^[0-9][0-9]*$/p;}' "$ISSUED_PATH" 2>/dev/null || true)
    if [ -n "$seen" ] && [ "$issued" -lt "$seen" ]; then
        return 5
    fi
    printf '%s\n' "$issued" >"$ISSUED_PATH"
    printf '%s' "$channel_version"
}

# The version to pin: the latest release, or on `testing` what the channel serves
# when that is newer.
resolve_target() {
    target=$(resolve_latest) || return 1
    if [ "$CHANNEL" = testing ]; then
        rc=0
        candidate=$(signed_channel_version) || rc=$?
        # Without a usable file the stable release is still a target: the caller decides.
        if [ "$rc" -ne 0 ]; then
            printf '%s' "$target"
            return $((rc + 10))
        fi
        if version_gt "$candidate" "$target"; then
            target=$candidate
        fi
    fi
    printf '%s' "$target"
}

# Digest of the OCI index for $1, from the release's OCI-DIGESTS file signed
# with the Meshloom release key. The file holds exactly one line:
#   ghcr.io/twinrocket/meshloom:<tag> sha256:<64 lowercase hex>
signed_digest() {
    tag=$1
    curl -fsSL --proto '=https' --max-time 60 -o "$WORK/OCI-DIGESTS" \
        "${REPO_URL}/releases/download/${tag}/OCI-DIGESTS" || return 2
    curl -fsSL --proto '=https' --max-time 60 -o "$WORK/OCI-DIGESTS.asc" \
        "${REPO_URL}/releases/download/${tag}/OCI-DIGESTS.asc" || return 2
    gpgv --keyring "$KEYRING" "$WORK/OCI-DIGESTS.asc" "$WORK/OCI-DIGESTS" >/dev/null 2>&1 || return 3
    [ "$(wc -l <"$WORK/OCI-DIGESTS" | tr -d ' ')" = 1 ] || return 4
    escaped=$(printf '%s' "$tag" | sed 's/\./\\./g')
    line=$(grep -E "^ghcr\.io/twinrocket/meshloom:${escaped} sha256:[0-9a-f]{64}\$" "$WORK/OCI-DIGESTS" || true)
    [ -n "$line" ] || return 4
    digest=${line##* }
    printf '%s\n' "$digest" | grep -Eq "$DIGEST_RE" || return 4
    printf '%s' "$digest"
}

# Version currently pinned in .env, or empty when there is no valid pin.
current_version() {
    [ -f "$ENV_FILE" ] || return 0
    sed -n 's/^MESHLOOM_IMAGE=//p' "$ENV_FILE" | head -n 1 |
        sed -n "s|^ghcr\.io/twinrocket/meshloom:\([0-9]*\.[0-9]*\.[0-9]*\(-rc\.[1-9][0-9]*\)\{0,1\}\)@sha256:[0-9a-f]\{64\}\$|\1|p"
}

write_env() {
    image="${IMAGE_REPO}:$1@$2"
    tmp=$(mktemp "$COMPOSE_DIR/.env.XXXXXX")
    {
        echo "# Managed by meshloom-compose-update. MESHLOOM_IMAGE is pinned by digest."
        echo "MESHLOOM_IMAGE=${image}"
        if [ -f "$ENV_FILE" ]; then
            grep -v -e '^MESHLOOM_IMAGE=' -e '^# Managed by meshloom-compose-update' "$ENV_FILE" || true
        fi
    } >"$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$ENV_FILE"
}

trap on_exit EXIT
trap 'on_exit; exit 130' INT
trap 'on_exit; exit 143' TERM

if [ -z "$R" ] && [ "$(id -u)" -ne 0 ]; then
    log "must run as root"
    exit 1
fi
umask 022

# Only the directory and the channel come from /etc/meshloom/compose-update.env
# (root-owned, passed by systemd EnvironmentFile=). They are validated, never sourced.
CHANNEL="${MESHLOOM_UPDATE_CHANNEL:-stable}"
case "$CHANNEL" in
    stable | testing) ;;
    *)
        log "invalid MESHLOOM_UPDATE_CHANNEL"
        exit 1
        ;;
esac
COMPOSE_DIR="${MESHLOOM_COMPOSE_DIR:-}"
if ! printf '%s\n' "$COMPOSE_DIR" | grep -Eq "$DIR_RE" || [ "$(printf '%s\n' "$COMPOSE_DIR" | wc -l)" -ne 1 ]; then
    log "invalid MESHLOOM_COMPOSE_DIR"
    exit 1
fi
case "/$COMPOSE_DIR/" in
    */../* | */./*)
        log "invalid MESHLOOM_COMPOSE_DIR"
        exit 1
        ;;
esac
COMPOSE_DIR="$R$COMPOSE_DIR"
if [ ! -d "$COMPOSE_DIR" ] || [ -L "$COMPOSE_DIR" ]; then
    log "compose directory missing: $COMPOSE_DIR"
    exit 1
fi
ENV_FILE="$COMPOSE_DIR/.env"
STATUS_DIR="$COMPOSE_DIR/update-status"
if [ -L "$STATUS_DIR" ]; then
    log "refusing symlinked $STATUS_DIR"
    exit 1
fi
mkdir -p "$STATUS_DIR"
chmod 0755 "$STATUS_DIR"
if ! is_root_owned_dir "$STATUS_DIR"; then
    log "$STATUS_DIR must be a root-owned directory"
    exit 1
fi
STATUS_READY=1

for d in "$STATE_DIR" "$RUN_DIR"; do
    if [ -L "$d" ]; then fail "unsafe helper directory"; fi
    mkdir -p "$d"
    chmod 0700 "$d"
done
WORK=$(mktemp -d "$RUN_DIR/work.XXXXXX")

if [ "$MODE" = apply ]; then
    now=$(date +%s)
    last=$(sed -n '1{/^[0-9][0-9]*$/p;}' "$STAMP_PATH" 2>/dev/null || true)
    if [ -n "$last" ] && [ "$now" -ge "$last" ] && [ $((now - last)) -lt "$COOLDOWN_SECONDS" ]; then
        FINISHED=1
        STATE=cooldown
        ERROR="update requested too soon; try again in $((COOLDOWN_SECONDS - (now - last))) s"
        VERSION=$(current_version)
        write_status
        log "$ERROR"
        exit 0
    fi
    printf '%s\n' "$now" >"$STAMP_PATH"
fi

CURRENT=$(current_version)
VERSION=$CURRENT
write_status

[ -s "$KEYRING" ] || fail "release key missing ($KEYRING); re-run the installer"
command -v gpgv >/dev/null 2>&1 || fail "gpgv is not installed"

rc=0
TARGET=$(resolve_target) || rc=$?
CHANNEL_PROBLEM=""
case "$rc" in
    0) ;;
    12) CHANNEL_PROBLEM="could not download the channel file" ;;
    13) CHANNEL_PROBLEM="channel file signature check failed" ;;
    14) CHANNEL_PROBLEM="invalid channel file" ;;
    15) CHANNEL_PROBLEM="refusing a channel file older than the last one seen" ;;
    *) fail "could not resolve the latest release" ;;
esac
# A problem with the file only matters if the stable release is not an update by itself.
if [ -n "$CHANNEL_PROBLEM" ]; then
    if [ -z "$CURRENT" ] || ! version_gt "$TARGET" "$CURRENT"; then
        fail "$CHANNEL_PROBLEM"
    fi
    log "$CHANNEL_PROBLEM; following the stable release $TARGET"
fi
rc=0
DIGEST=$(signed_digest "$TARGET") || rc=$?
case "$rc" in
    0) ;;
    2) fail "could not download OCI-DIGESTS for $TARGET" ;;
    3) fail "OCI-DIGESTS signature check failed for $TARGET" ;;
    *) fail "no signed image digest for $TARGET" ;;
esac

if [ -n "$CURRENT" ]; then
    if version_gt "$CURRENT" "$TARGET"; then
        fail "refusing downgrade from $CURRENT to $TARGET"
    fi
    if [ "$CURRENT" = "$TARGET" ] && grep -qx "MESHLOOM_IMAGE=${IMAGE_REPO}:${TARGET}@${DIGEST}" "$ENV_FILE"; then
        if [ "$MODE" = apply ]; then
            # Already pinned: still make sure that image is the one running.
            :
        else
            FINISHED=1
            STATE=succeeded
            PHASE=done
            PERCENT=100
            write_status
            exit 0
        fi
    fi
elif [ "$MODE" = apply ]; then
    fail "no valid MESHLOOM_IMAGE pin in $ENV_FILE; re-run the installer"
fi

write_env "$TARGET" "$DIGEST"
log "pinned ${IMAGE_REPO}:${TARGET}@${DIGEST}"

if [ "$MODE" = bootstrap ]; then
    FINISHED=1
    STATE=succeeded
    PHASE=done
    PERCENT=100
    VERSION=$TARGET
    write_status
    exit 0
fi

cd "$COMPOSE_DIR"
PHASE=downloading
write_status
docker compose pull || fail "docker compose pull failed"
PHASE=restarting
PERCENT=90
write_status
docker compose up -d || fail "docker compose up -d failed"
FINISHED=1
STATE=succeeded
PHASE=done
PERCENT=100
VERSION=$TARGET
write_status
log "running ${TARGET}"
